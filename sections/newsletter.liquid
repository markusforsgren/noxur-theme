<section class="newsletter" id="nyhetsbrev">
  <div class="wrap newsletter__inner reveal">
    <h2 class="serif newsletter__title">{{ section.settings.heading }}{% if section.settings.heading_em != blank %} <em>{{ section.settings.heading_em }}</em>{% endif %}</h2>
    <div class="newsletter__form">
      {%- form 'customer', id: 'nyhetsbrev-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter__field">
          <label for="nyhetsbrev-epost" class="visually-hidden">E-postadress</label>
          <input id="nyhetsbrev-epost" type="email" name="contact[email]" placeholder="Din e-postadress" autocomplete="email" required>
          <button type="submit">Prenumerera →</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="form-msg" role="status">Tack! Du är med på listan.</p>
        {%- elsif form.errors -%}
          <p class="form-msg" role="alert">Kontrollera e-postadressen och försök igen.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nyhetsbrev",
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Nya ur först." },
    { "type": "text", "id": "heading_em", "label": "Rubrik, kursiv del", "default": "Inget annat." }
  ],
  "presets": [{ "name": "Nyhetsbrev" }]
}
{% endschema %}
