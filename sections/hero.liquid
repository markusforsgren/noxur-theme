{%- assign brand = section.settings.brand | default: shop.name | upcase -%}
{%- assign chars = brand | split: '' -%}
{%- capture letters -%}
  {%- for ch in chars -%}
    {%- assign delay = forloop.index0 | times: 0.07 | plus: 0.35 -%}
    <span class="ltr" aria-hidden="true" style="animation-delay:{{ delay }}s">{% if ch == ' ' %}&nbsp;{% else %}{{ ch }}{% endif %}</span>
  {%- endfor -%}
{%- endcapture -%}

<section class="hero" data-tilt-area>
  <svg class="hero__ring" aria-hidden="true" viewBox="0 0 800 800">
    <circle cx="400" cy="400" r="396" fill="none" stroke="#EDEAE4" stroke-opacity="0.18" stroke-width="1" stroke-dasharray="1 13"/>
    <circle cx="400" cy="400" r="370" fill="none" stroke="currentColor" stroke-opacity="0.18" stroke-width="1" style="color:var(--accent)"/>
  </svg>

  <div class="hero__stage">
    {%- if section.settings.text_style == 'layered' -%}
      <div class="hero__text hero__text--back">
        <h1 class="hero__title" aria-label="{{ brand | escape }}">{{ letters }}</h1>
      </div>
    {%- endif -%}

    <div class="hero__watch">
      <div class="hero__watch-in">
        <div class="hero__tilt" data-tilt>
          <div class="hero__breathe">
            {%- if section.settings.image != blank -%}
              {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'hero__img', alt: section.settings.image.alt, loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 800px) 40vw, 80vw', widths: '600, 900, 1200, 1400' }}
            {%- else -%}
              <img class="hero__img" src="{{ 'hero-watch.png' | asset_url }}" alt="Armbandsur" width="405" height="721" fetchpriority="high">
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    {%- case section.settings.text_style -%}
      {%- when 'layered' -%}
        <div class="hero__text hero__text--front" aria-hidden="true">
          <div class="hero__title hero__title--outline">{{ letters }}</div>
        </div>
      {%- when 'blend' -%}
        <div class="hero__text hero__text--front hero__text--blend">
          <h1 class="hero__title" aria-label="{{ brand | escape }}">{{ letters }}</h1>
        </div>
      {%- else -%}
        <div class="hero__text hero__text--front">
          <h1 class="hero__title hero__title--solid" aria-label="{{ brand | escape }}">{{ letters }}</h1>
        </div>
    {%- endcase -%}
  </div>

  <div class="hero__bottom">
    <div class="hero__line"></div>
    <div class="hero__row">
      {%- if section.settings.tagline != blank -%}
        <p class="hero__tagline anim-up d1">{{ section.settings.tagline }}</p>
      {%- endif -%}
      <div class="scroll-cue anim-up d2"><span class="scroll-cue__bar"><span></span></span>Scrolla</div>
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--solid anim-up d3" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label }}
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero med klocka",
  "settings": [
    { "type": "text", "id": "brand", "label": "Stor text", "default": "NOXUR" },
    {
      "type": "select", "id": "text_style", "label": "Textstil", "default": "layered",
      "options": [
        { "value": "layered", "label": "Bakom + kontur" },
        { "value": "blend", "label": "Blandat" },
        { "value": "solid", "label": "Solid" }
      ]
    },
    { "type": "image_picker", "id": "image", "label": "Klockbild", "info": "Använd en PNG med genomskinlig bakgrund, stående format." },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Äkta ur. Levererade inom några dagar." },
    { "type": "text", "id": "button_label", "label": "Knapptext", "default": "Se kollektionen" },
    { "type": "url", "id": "button_link", "label": "Knapplänk" }
  ],
  "presets": [{ "name": "Hero med klocka" }]
}
{% endschema %}
