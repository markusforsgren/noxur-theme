{%- assign current = product.selected_or_first_available_variant -%}
<section class="wrap product">
  <div class="product__gallery" data-gallery>
    <div class="product__main">
      {%- assign first = current.featured_media | default: product.featured_media -%}
      {%- if first -%}
        {{ first | image_url: width: 1600 | image_tag: data-gallery-main: 'true', loading: 'eager', alt: first.alt | default: product.title, sizes: '(min-width: 900px) 50vw, 100vw', widths: '600, 900, 1200, 1600' }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    {%- if product.media.size > 1 -%}
      <div class="product__thumbs">
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            <button class="product__thumb" type="button" data-gallery-thumb data-src="{{ media | image_url: width: 1600 }}" data-alt="{{ media.alt | default: product.title | escape }}" aria-current="{% if media.id == first.id %}true{% else %}false{% endif %}" aria-label="Visa bild {{ forloop.index }}">
              {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product__info">
    {%- if product.vendor != blank -%}<p class="product__vendor">{{ product.vendor }}</p>{%- endif -%}
    <h1 class="product__title">{{ product.title }}</h1>
    <div class="product__price">{% render 'price', product: product, variant: current %}</div>

    {%- form 'product', product, class: 'product__form', data-ajax-cart: 'true' -%}
      {%- if product.has_only_default_variant -%}
        <input type="hidden" name="id" value="{{ current.id }}">
      {%- else -%}
        <div class="field">
          <label for="variant-{{ section.id }}">Variant</label>
          <select id="variant-{{ section.id }}" name="id">
            {%- for v in product.variants -%}
              <option value="{{ v.id }}"{% if v.id == current.id %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title }} – {{ v.price | money }}{% unless v.available %} (slut){% endunless %}</option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
      <div class="field">
        <label for="qty-{{ section.id }}">Antal</label>
        <input id="qty-{{ section.id }}" type="number" name="quantity" value="1" min="1" style="max-width:120px">
      </div>
      {%- if product.available -%}
        <button class="btn btn--solid btn--full" type="submit">Lägg i korgen</button>
      {%- else -%}
        <button class="btn btn--line btn--full" type="button" disabled>Slutsåld</button>
      {%- endif -%}
      {{ form | payment_terms }}
    {%- endform -%}

    {%- if product.description != blank -%}
      <div class="product__desc rte">{{ product.description }}</div>
    {%- endif -%}

    <div class="product__trust">
      <ul>
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="color:var(--accent)"><path d="M5 12l5 5L20 7"/></svg>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

<script type="application/ld+json">{{ product | structured_data }}</script>

{% schema %}
{
  "name": "Produkt",
  "blocks": [
    { "type": "trust", "name": "Trygghetsrad", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Äkta vara med tillverkarens garanti" }] }
  ]
}
{% endschema %}
