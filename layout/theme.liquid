<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0B0B0C">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}{% if current_page != 1 %} – sida {{ current_page }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">{% endif %}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=Manrope:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: {{ settings.color_bg }};
      --text: {{ settings.color_text }};
      --accent: {{ settings.color_accent }};
    }
  </style>
  {{ 'noxur.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'noxur.js' | asset_url }}" defer></script>

  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="skip-link" href="#main">Hoppa till innehållet</a>
  {% section 'header' %}
  <main id="main" role="main">
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}
  <div class="toast" data-toast role="status" aria-live="polite"></div>
</body>
</html>
