{%- comment -%}
  Produktkort. Används: {% render 'product-card', product: product, tag: 'Nyhet' %}
{%- endcomment -%}
{%- assign variant = product.selected_or_first_available_variant -%}
<article class="card reveal" data-type="{{ product.type | handleize | default: 'ovrigt' }}">
  <a class="card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {%- if product.compare_at_price > product.price -%}
      <span class="card__tag">Rea</span>
    {%- elsif product.tags contains 'nyhet' or product.tags contains 'Nyhet' -%}
      <span class="card__tag">Nyhet</span>
    {%- elsif product.type != blank -%}
      <span class="card__tag">{{ product.type }}</span>
    {%- endif -%}
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.featured_media.alt | default: product.title, sizes: '(min-width: 1100px) 25vw, (min-width: 700px) 33vw, 50vw', widths: '400, 600, 900' }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
    <span class="card__bar"></span>
  </a>
  <div class="card__body">
    <div class="card__top">
      <h3 class="card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
      {% render 'price', product: product %}
    </div>
    {%- if product.vendor != blank -%}<p class="card__vendor">{{ product.vendor }}</p>{%- endif -%}
  </div>
  <div class="card__foot">
    {%- if product.has_only_default_variant and variant.available -%}
      {%- form 'product', product, data-ajax-cart: 'true' -%}
        <input type="hidden" name="id" value="{{ variant.id }}">
        <button class="btn btn--line" type="submit">Lägg i korgen</button>
      {%- endform -%}
    {%- elsif product.available -%}
      <a class="btn btn--line" href="{{ product.url }}">Välj variant</a>
    {%- else -%}
      <button class="btn btn--line" type="button" disabled>Slutsåld</button>
    {%- endif -%}
  </div>
</article>
