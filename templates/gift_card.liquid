{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Presentkort – {{ shop.name }}</title>
  <style>:root{--bg:{{ settings.color_bg }};--text:{{ settings.color_text }};--accent:{{ settings.color_accent }}}</style>
  {{ 'noxur.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="wrap empty" style="padding-top:96px;text-align:center">
    <p class="eyebrow">{{ shop.name }}</p>
    <h1 class="h2">Presentkort på {{ gift_card.initial_value | money }}</h1>
    {%- if gift_card.expired or gift_card.enabled == false -%}
      <p class="soft">Presentkortet är inte längre giltigt.</p>
    {%- else -%}
      <p class="soft" style="margin:24px 0 8px">Kvar att använda: {{ gift_card.balance | money }}</p>
      <p style="font-size:28px;letter-spacing:.12em;margin:24px 0">{{ gift_card.code | format_code }}</p>
      {%- if gift_card.expires_on -%}<p class="muted">Giltigt till {{ gift_card.expires_on | date: '%Y-%m-%d' }}</p>{%- endif -%}
      <p style="margin-top:32px"><a class="btn btn--solid" href="{{ shop.url }}">Handla nu</a></p>
    {%- endif -%}
  </main>
</body>
</html>
