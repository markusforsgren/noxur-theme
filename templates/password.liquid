{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} – öppnar snart</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@400&family=Manrope:wght@400;500&display=swap" rel="stylesheet">
  <style>:root{--bg:{{ settings.color_bg }};--text:{{ settings.color_text }};--accent:{{ settings.color_accent }}}</style>
  {{ 'noxur.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="hero" style="text-align:center">
    <img src="{{ 'hero-watch.png' | asset_url }}" alt="" width="405" height="721" style="height:46vh;width:auto;margin:0 auto 32px;filter:drop-shadow(0 40px 40px rgba(0,0,0,.7))">
    <h1 class="hero__title" style="font-size:clamp(48px,10vw,140px);position:static">{{ shop.name }}</h1>
    <p class="hero__tagline" style="margin:16px 0 40px">{{ shop.password_message | default: 'Öppnar snart.' }}</p>
    {%- form 'customer', style: 'width:100%;max-width:440px' -%}
      <input type="hidden" name="contact[tags]" value="prelansering">
      <div class="newsletter__field">
        <label for="pw-email" class="visually-hidden">E-postadress</label>
        <input id="pw-email" type="email" name="contact[email]" placeholder="Meddela mig när vi öppnar" required>
        <button type="submit">Skicka →</button>
      </div>
      {%- if form.posted_successfully? -%}<p class="form-msg">Tack! Vi hör av oss.</p>{%- endif -%}
    {%- endform -%}
    <details style="margin-top:48px;font-size:13px;color:#ABA69D">
      <summary style="cursor:pointer">Butiksägare? Logga in</summary>
      {%- form 'storefront_password', style: 'margin-top:16px' -%}
        <div class="newsletter__field">
          <label for="pw" class="visually-hidden">Lösenord</label>
          <input id="pw" type="password" name="password" placeholder="Lösenord">
          <button type="submit">Öppna →</button>
        </div>
        {%- if form.errors -%}<p class="form-msg">Fel lösenord.</p>{%- endif -%}
      {%- endform -%}
    </details>
  </main>
</body>
</html>
